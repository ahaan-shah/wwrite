#!/usr/bin/env sh
# Install wwrite into the current user's ~/.local tree. No root, no makepkg,
# no package repository: everything lands under XDG user directories, so
# `bin/uninstall` can take all of it back out again.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

PREFIX="${PREFIX:-$HOME/.local}"
BINDIR="$PREFIX/bin"
DATADIR="${XDG_DATA_HOME:-$HOME/.local/share}"
ICONDIR="$DATADIR/icons/hicolor"
APPDIR="$DATADIR/applications"

# Which icon name the launcher entry points at. Defaults to the art bundled in
# packaging/, which ships with the project and is MIT like the rest of it. Set
# ICON to any icon-theme name to borrow your desktop theme's icon instead, e.g.
# ICON=org.gnome.TextEditor. The bundled art is installed either way.
ICON="${ICON:-wwrite}"

"$ROOT/bin/build"

install -Dm755 "$ROOT/build/wwrite" "$BINDIR/wwrite"

# Scalable icon plus rasterised sizes: some docks and launchers still pick a
# PNG over an SVG, and a few will not scale the SVG at all.
install -Dm644 "$ROOT/packaging/wwrite.svg" "$ICONDIR/scalable/apps/wwrite.svg"
if command -v rsvg-convert >/dev/null 2>&1; then
  for size in 16 24 32 48 64 128 256; do
    mkdir -p "$ICONDIR/${size}x${size}/apps"
    rsvg-convert -w "$size" -h "$size" "$ROOT/packaging/wwrite.svg" \
      -o "$ICONDIR/${size}x${size}/apps/wwrite.png"
    chmod 644 "$ICONDIR/${size}x${size}/apps/wwrite.png"
  done
fi

# Launchers started by the compositor do not always inherit a login shell's
# PATH, so bake the real path into Exec rather than relying on `wwrite` resolving.
mkdir -p "$APPDIR"
sed -e "s|@BINDIR@|$BINDIR|g" -e "s|@ICON@|$ICON|g" \
    "$ROOT/packaging/wwrite.desktop" > "$APPDIR/wwrite.desktop"
chmod 644 "$APPDIR/wwrite.desktop"

# gtk-update-icon-cache indexes nothing without an index.theme, and the empty
# cache it leaves behind can stop GTK finding the icon at all. A user-local
# hicolor tree usually has no index.theme, so seed one from the system copy.
if [ ! -f "$ICONDIR/index.theme" ] && [ -f /usr/share/icons/hicolor/index.theme ]; then
  install -Dm644 /usr/share/icons/hicolor/index.theme "$ICONDIR/index.theme"
fi

gtk-update-icon-cache -q -t -f "$ICONDIR" >/dev/null 2>&1 || true
update-desktop-database -q "$APPDIR" >/dev/null 2>&1 || true

echo "Installed:"
echo "  $BINDIR/wwrite"
echo "  $APPDIR/wwrite.desktop"
echo "  $ICONDIR/scalable/apps/wwrite.svg   (launcher icon name: $ICON)"

case ":$PATH:" in
  *":$BINDIR:"*) ;;
  *) echo; echo "Note: $BINDIR is not on your PATH; add it to run 'wwrite' from a shell." ;;
esac
